{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug ft_malloc test",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/test/test_debug",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [
				{
					"name": "LD_LIBRARY_PATH",
					"value": "${workspaceFolder}:${env:LD_LIBRARY_PATH}"
				}
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",
			"preLaunchTask": "build test debug",
			"setupCommands": [
				{
					"description": "Enable GDB pretty printing",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		}
	]
}
